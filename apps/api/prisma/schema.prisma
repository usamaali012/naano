generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COMPANY
  CREATOR
  ADMIN
}

enum Vertical {
  SALES
  REVOPS
  DEVTOOLS
  HR_TECH
  PRODUCT
  MARKETING_OPS
  FINTECH
  VERTICAL_SAAS
}

enum Network {
  LINKEDIN
  X
}

enum CampaignStatus {
  DRAFT
  LIVE
  COMPLETED
}

enum BookingStatus {
  INVITED
  ACCEPTED
  DECLINED
  DRAFT_READY
  SCHEDULED
  LIVE
  PAID
}

// Which side opened the deal. "Invitations received" vs "sent" in the
// Collaborations view is this field read from the other party's seat.
enum BookingInitiator {
  BRAND
  CREATOR
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

// The four axes a creator's audience is broken down along. Each axis has its
// own set of segments that sum to 100.
enum AudienceDimension {
  JOB_TITLE
  SENIORITY
  INDUSTRY
  GEOGRAPHY
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  company        Company?
  creatorProfile CreatorProfile?
}

model Company {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  website   String?
  logoUrl   String?
  createdAt DateTime @default(now())

  campaigns Campaign[]
}

model CreatorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  displayName   String
  headline      String
  avatarUrl     String?
  vertical      Vertical
  network       Network  @default(LINKEDIN)
  followerCount Int
  country       String
  language      String

  // Money the brand pays. CPM is postCostCents / medianViews * 1000 and is
  // computed at the render boundary, never stored.
  postCostCents     Int
  bundle5PriceCents Int

  // Verified performance signal that replaces the old avgImpressions.
  medianViews Int

  // Backs the "estimated from N recent public engagers" / "N posts analyzed"
  // captions in the profile modal. Real numbers, not copy.
  observedEngagerCount Int
  postsAnalyzed        Int

  engagementRate Float
  createdAt      DateTime @default(now())

  bookings         Booking[]
  audienceSegments AudienceSegment[]
  posts            CreatorPost[]
  shortlistItems   ShortlistItem[]

  @@index([vertical])
  @@index([country])
  @@index([network])
}

// One slice of one audience dimension for one creator. Four dimensions per
// creator, four segments per dimension, each dimension summing to 100.
model AudienceSegment {
  id               String            @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile    @relation(fields: [creatorProfileId], references: [id])
  dimension        AudienceDimension
  label            String
  percentage       Int
  createdAt        DateTime          @default(now())

  @@index([creatorProfileId])
  @@index([creatorProfileId, dimension])
}

// A recent public post scraped from the creator's feed. Five per creator.
// Feeds the Content tab carousel and the reach sparkline.
model CreatorPost {
  id               String         @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])
  network          Network
  content          String
  publishedAt      DateTime
  views            Int
  reactions        Int
  comments         Int
  reposts          Int
  externalUrl      String

  @@index([creatorProfileId])
  @@index([publishedAt])
}

model Campaign {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  name           String
  objective      String
  brief          String
  keyMessages    String
  guidelines     String
  destinationUrl String
  budgetCents    Int
  status         CampaignStatus @default(DRAFT)

  // The buyer vertical this campaign is trying to reach. Drives the per-
  // (creator, campaign) ICP fit score and the "sector fit first" half of the
  // marketplace best_match ranking (docs/RECON.md §4). One vertical per
  // campaign is enough for the fit rule; richer targeting can grow off Icp.
  targetVertical Vertical
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime       @default(now())

  bookings       Booking[]
  icps           Icp[]
  shortlistItems ShortlistItem[]

  @@index([companyId])
  @@index([status])
}

// A creator saved to a campaign's shortlist. Campaign-scoped, not brand-scoped:
// the marketplace Shortlist tab and the campaign Shortlist tab read the same
// rows for the campaign in context.
model ShortlistItem {
  id               String         @id @default(cuid())
  campaignId       String
  campaign         Campaign       @relation(fields: [campaignId], references: [id])
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])
  createdAt        DateTime       @default(now())

  @@unique([campaignId, creatorProfileId])
  @@index([campaignId])
  @@index([creatorProfileId])
}

// The ICP cards extracted during brand onboarding. A campaign carries up to
// three; `rank` is 1..3 and unique per campaign.
model Icp {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  rank        Int
  title       String
  description String
  createdAt   DateTime @default(now())

  @@unique([campaignId, rank])
  @@index([campaignId])
}

model Booking {
  id               String           @id @default(cuid())
  campaignId       String
  campaign         Campaign         @relation(fields: [campaignId], references: [id])
  creatorProfileId String
  creatorProfile   CreatorProfile   @relation(fields: [creatorProfileId], references: [id])
  agreedPriceCents Int
  status           BookingStatus    @default(INVITED)
  initiatedBy      BookingInitiator @default(BRAND)
  deliverable      String
  deadline         DateTime?
  createdAt        DateTime         @default(now())

  post        Post?
  trackedLink TrackedLink?
  payout      Payout?

  @@index([campaignId])
  @@index([creatorProfileId])
  @@index([status])
}

model Post {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id])
  linkedinUrl String?
  content     String
  publishedAt DateTime?
  impressions Int       @default(0)
}

model TrackedLink {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id])
  slug           String   @unique
  destinationUrl String
  createdAt      DateTime @default(now())

  clickEvents ClickEvent[]

  @@index([slug])
}

model ClickEvent {
  id            String      @id @default(cuid())
  trackedLinkId String
  trackedLink   TrackedLink @relation(fields: [trackedLinkId], references: [id])
  createdAt     DateTime    @default(now())
  referrer      String?
  userAgent     String?
  ipHash        String
  isLead        Boolean     @default(false)

  @@index([trackedLinkId])
  @@index([createdAt])
}

model Payout {
  id          String       @id @default(cuid())
  bookingId   String       @unique
  booking     Booking      @relation(fields: [bookingId], references: [id])
  amountCents Int
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?

  @@index([status])
}
